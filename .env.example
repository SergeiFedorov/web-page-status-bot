# Copy to .env and fill in. Never commit .env!

# Token from @BotFather
BOT_TOKEN=
# Chat to send notifications to; groups are negative.
# Leave empty on first run, then send /chatid to the bot in that chat.
CHAT_ID=

# Random delay between checks is chosen from [MIN, MAX], in seconds
CHECK_INTERVAL_MIN=300
CHECK_INTERVAL_MAX=600
# While a slot is available, remind every N seconds
REMINDER_INTERVAL=3600

# Optional
#ANLIEGEN=RWTH Studenten
#DB_PATH=status_bot.sqlite3
#TIMEZONE=Europe/Berlin
